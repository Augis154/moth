extern fn printf(fmt: *u8, ...): i32;

struct Point {
  x: i32,
  y: f32,
}

fn main(): i64 {
  var str: []u8 = "Hello, World!";

  printf("%s\n".ptr, str.ptr);

  var p1: Point = .{ x: 10, y: 20.5 };
  var p2 = Point.{ x: 5, y: 12.34 };

  printf("Point 1: %d, %f\n".ptr, p1.x, p1.y);
  printf("Point 2: %d, %f\n".ptr, p2.x, p2.y);

  return 0;
}